<Window x:Class="MyDesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Desktop App" Height="220" Width="320">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="First number:" Width="100" VerticalAlignment="Center"/>
            <TextBox x:Name="FirstNumberTextBox" Width="120"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Second number:" Width="100" VerticalAlignment="Center"/>
            <TextBox x:Name="SecondNumberTextBox" Width="120"/>
        </StackPanel>

        <Button x:Name="AddButton" Grid.Row="2" Content="Add" Width="80"
                HorizontalAlignment="Left" Click="AddButton_Click" Margin="0,0,0,8"/>

        <TextBlock x:Name="ResultTextBlock" Grid.Row="3" Text="Result:" FontWeight="Bold"/>
    </Grid>
</Window>
